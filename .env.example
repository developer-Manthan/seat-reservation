# Copy to .env to override the dev-only defaults used by docker-compose.yml.
# Never commit real secrets. In production the app refuses dev defaults (profile prod).

PORT=8080

MYSQL_ROOT_PASSWORD=dev-only-root-password
MYSQL_DATABASE=seat_reservation
MYSQL_USER=seat
MYSQL_PASSWORD=dev-only-password

APP_DB_HOST=localhost
APP_DB_PORT=3307
APP_DB_NAME=seat_reservation
APP_DB_USER=seat
APP_DB_PASSWORD=dev-only-password
APP_DB_JDBC_PARAMS=allowPublicKeyRetrieval=true&useSSL=false

# Connection pool
APP_DB_POOL_SIZE=25
APP_DB_CONNECTION_TIMEOUT_MS=25000

# Auth
TOKEN_SECRET=dev-only-secret
ADMIN_TOKEN=dev-only-admin-token

# Reservations: all_or_nothing | best_effort
APP_RESERVATION_DEFAULT_MODE=all_or_nothing

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
