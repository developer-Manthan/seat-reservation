# Copy to .env to override the dev-only defaults used by docker-compose.yml.
# Never commit real secrets. In production the app refuses dev defaults (profile prod).

PORT=8080

# Database (use the names your hosting platform provides and map them here)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=seat_reservation
DB_USER=seat
DB_PASSWORD=dev-only-password
MYSQL_ROOT_PASSWORD=dev-only-root-password
# Extra JDBC URL parameters (dev defaults suit local MySQL without TLS)
DB_JDBC_PARAMS=allowPublicKeyRetrieval=true&useSSL=false

# Connection pool
DB_POOL_SIZE=25
DB_CONNECTION_TIMEOUT_MS=25000

# Auth
TOKEN_SECRET=dev-only-secret
ADMIN_TOKEN=dev-only-admin-token

# Reservations: all_or_nothing | best_effort
APP_RESERVATION_DEFAULT_MODE=all_or_nothing

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
